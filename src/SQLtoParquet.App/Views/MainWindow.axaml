<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLtoParquet.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="SQLtoParquet.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="SQLtoParquet"
        Width="1200" Height="760">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="12" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Content="Connect…" Click="ConnectButton_Click"/>
                    <TextBlock Text="{Binding ConnectionSummary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="About" Click="AboutButton_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="12">

            <!-- Export tab -->
            <TabItem Header="Export">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" x:DataType="vm:TableListViewModel" DataContext="{Binding TableList}">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                        <CheckBox Grid.Column="0" Content="Select all" IsChecked="{Binding IsAllSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Output folder:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Grid.Column="2" Text="{Binding OutputFolder}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="Browse…" Click="BrowseOutputFolder_Click" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Parallel:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <NumericUpDown Grid.Column="5" Value="{Binding MaxParallelism}" Minimum="1" Maximum="16" Width="130" FormatString="0" ShowButtonSpinner="True"/>
                        <TextBlock Grid.Column="6" Text="Rows/group:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <NumericUpDown Grid.Column="7" Value="{Binding RowsPerRowGroup}" Minimum="1000" Maximum="10000000" Increment="10000" Width="190" FormatString="0" ShowButtonSpinner="True"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
                        <ProgressBar Grid.Column="0" Value="{Binding OverallProgressPercent}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Start Export" Command="{Binding StartExportCommand}"/>
                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelExportCommand}" Margin="6,0,0,0"/>
                        <Button Grid.Column="3" Content="Open Log Folder" Click="OpenLogFolder_Click" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- List header -->
                    <Grid Grid.Row="2" ColumnDefinitions="32,260,90,100,90,140,100" Margin="4,0,4,4" Opacity="0.6">
                        <TextBlock Grid.Column="1" Text="Table" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Rows" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="SQL MB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="4" Text="Status" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="Progress" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="6" Text="Parquet MB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Tables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TableExportRowViewModel">
                                        <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid ColumnDefinitions="32,260,90,100,90,140,100" ToolTip.Tip="{Binding ErrorMessage}">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding QualifiedName}" VerticalAlignment="Center" ToolTip.Tip="{Binding QualifiedName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RowCountDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TotalSizeMbDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <ProgressBar Grid.Column="5" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="14" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                <TextBlock Grid.Column="6" Text="{Binding ParquetFileSizeMbDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Opacity="0.75" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- Analyze (DuckDB) tab -->
            <TabItem Header="Analyze (DuckDB)">
                <Grid RowDefinitions="Auto,Auto,Auto,*" x:DataType="vm:AnalysisViewModel" DataContext="{Binding Analysis}">
                    <TextBlock Grid.Row="0" Text="Query the exported Parquet files with DuckDB SQL (e.g. read_parquet('folder/*.parquet')):" Margin="0,0,0,6" Opacity="0.8"/>
                    <TextBox Grid.Row="1" Text="{Binding SqlText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" FontFamily="Consolas,Cascadia Mono,monospace"/>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,8,0,8">
                        <Button Grid.Column="0" Content="Run Query" Command="{Binding RunQueryCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8"/>
                    </Grid>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Results.DefaultView}" AutoGenerateColumns="True" IsReadOnly="True" GridLinesVisibility="Horizontal"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
